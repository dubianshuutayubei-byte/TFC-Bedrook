{
  "format_version": "1.8.0",
  "minecraft:spawn_rules": {
    "description": {
      "identifier": "tfc:crocodile",
      "population_control": "animal"
    },
    "conditions": [
      {
        "minecraft:brightness_filter": {
          "min": 0,
          "max": 15,
          "adjust_for_weather": true
        },
        "minecraft:weight": {
          "default": 1
        },
        "minecraft:herd": {
          "min_size": 1,
          "max_size": 2
        },
        "minecraft:biome_filter": {
          "any_of": [
            {
              "test": "has_biome_tag",
              "operator": "==",
              "value": "swamp"
            },
            {
              "test": "has_biome_tag",
              "operator": "==",
              "value": "jungle"
            },
            {
              "test": "has_biome_tag",
              "operator": "==",
              "value": "river"
            }
          ]
        },
        "minecraft:spawns_on_surface": {}
      }
    ]
  }
}
